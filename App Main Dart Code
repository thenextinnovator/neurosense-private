  // Seeders
  static void _seedTelemetryHistory() {
    final now = DateTime.now();
    final List<TelemetryPoint> seeds = [];
    for (int i = 23; i >= 0; i--) {
      final t = now.subtract(Duration(hours: i));
      final h = t.hour;
      final isNight = h >= 23 || h < 6;
      final isWork = h >= 9 && h <= 17;
      final stress = isNight ? 18 + Random().nextInt(10) : (isWork ? 45 + Random().nextInt(30) : 25 + Random().nextInt(18));
      final hr = isNight ? 58 + Random().nextInt(8) : (isWork ? 78 + Random().nextInt(16) : 68 + Random().nextInt(10));
      final hrv = isNight ? 85 - Random().nextInt(10) : (stress > 65 ? 38 + Random().nextInt(12) : 65 + Random().nextInt(15));
      final emg = isNight ? 6 : (stress > 60 ? 32 + Random().nextInt(14) : 13 + Random().nextInt(7));

      seeds.add(TelemetryPoint(
