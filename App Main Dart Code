class _CircadianTrendPainter extends CustomPainter {
  final List<HourlyTelemetryAggregate> data;
  _CircadianTrendPainter({required this.data});

  @override
  void paint(Canvas canvas, Size size) {
    if (data.isEmpty) return;
    final gridPaint = Paint()..color = Colors.white.withValues(alpha: 0.08)..strokeWidth = 1;
    for (int i = 1; i <= 3; i++) {
      final y = size.height * (i / 4);
      canvas.drawLine(Offset(0, y), Offset(size.width, y), gridPaint);
    }

    final pHR = Paint()..color = const Color(0xFFEC4899)..strokeWidth = 2.5..style = PaintingStyle.stroke..strokeCap = StrokeCap.round;
    final pHRV = Paint()..color = cAccentGreen..strokeWidth = 2.5..style = PaintingStyle.stroke..strokeCap = StrokeCap.round;

    final pathHR = Path();
    final pathHRV = Path();

    final dx = size.width / (data.length - 1);
    for (int i = 0; i < data.length; i++) {
      final hr = data[i].avgHr.clamp(40, 130);
      final hrv = data[i].avgHrv.clamp(20, 110);

      final yHR = size.height - ((hr - 40) / 90 * size.height);
      final yHRV = size.height - ((hrv - 20) / 90 * size.height);

      if (i == 0) {
        pathHR.moveTo(0, yHR);
        pathHRV.moveTo(0, yHRV);
      } else {
        pathHR.lineTo(i * dx, yHR);
        pathHRV.lineTo(i * dx, yHRV);
      }
    }
    canvas.drawPath(pathHR, pHR);
    canvas.drawPath(pathHRV, pHRV);
  }

