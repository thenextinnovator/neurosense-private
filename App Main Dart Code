// 6. HARDWARE & BLUETOOTH LE (BLE) GATEWAY SERVICE
// ═══════════════════════════════════════════════════════════════════════════════
class BleService {
  static final BleService instance = BleService._();
  BleService._();

  BluetoothDevice? connectedDevice;
  BluetoothCharacteristic? dataChar;
  BluetoothCharacteristic? cmdChar;
  bool isConnected = false;
  bool isScanning = false;
  bool isSimulated = true;

  final _vitalsController = StreamController<VitalsData>.broadcast();
  Stream<VitalsData> get vitalsStream => _vitalsController.stream;

  final _ppgStreamController = StreamController<double>.broadcast();
  Stream<double> get ppgStream => _ppgStreamController.stream;

  final _stateController = StreamController<String>.broadcast();
  Stream<String> get stateStream => _stateController.stream;

  Timer? _telemetryTimer;
  Timer? _ppgOscTimer;
  double _ppgPhase = 0.0;
  VitalsData _currentVitals = VitalsData.defaultData();
  VitalsData get currentVitals => _currentVitals;

  void startSimulation() {
    isSimulated = true;
    _telemetryTimer?.cancel();
    _ppgOscTimer?.cancel();

    // 50Hz continuous Carotid PPG wave generation with dicrotic notch
    _ppgOscTimer = Timer.periodic(const Duration(milliseconds: 20), (_) {
      _ppgPhase += 0.145;
      final base = sin(_ppgPhase);
      final dicrotic = 0.35 * sin(2 * _ppgPhase + 1.25);
      final noise = (Random().nextDouble() * 2 - 1);
      final ppg = 50 + (base * 32) + (dicrotic * 18) + noise;
      _ppgStreamController.add(ppg.clamp(5.0, 95.0));
    });

    // 1Hz Telemetry Loop
    _telemetryTimer = Timer.periodic(const Duration(seconds: 1), (t) {
      final now = DateTime.now();
      final hr = 68 + (sin(t.tick * 0.12) * 8).round() + Random().nextInt(4);
      final hrv = 64 + (cos(t.tick * 0.08) * 12).round() + Random().nextInt(5);
      final stress = (34 + (sin(t.tick * 0.18) * 16) + Random().nextInt(6)).clamp(12, 92).toInt();
      final emg = (13 + (cos(t.tick * 0.25) * 6)).round().clamp(4, 48);

      String cond = 'Nominal Vagal Balance';
      if (stress > 65) cond = 'Sympathetic Dominance';
      if (stress < 28) cond = 'Parasympathetic Flow';

      _currentVitals = VitalsData(
        stress: stress,
        anxiety: (stress * 0.6).round(),
        focus: (100 - stress * 0.4).round(),
        heartRate: hr,
        temp: 36.6 + (sin(t.tick * 0.05) * 0.15),
        oxygen: 99,
        steps: 5120 + (t.tick * 2),
        battery: 94,
        emg: emg,
        posture: 96,
        hrv: hrv,
        fall: 0,
        faint: 0,
        cond: cond,
        bp: stress > 65 ? '126/82' : '118/76',
        resp: 14 + (sin(t.tick * 0.1) * 2).round(),
        timestamp: now.millisecondsSinceEpoch,
        timeStr: "${now.hour.toString().padLeft(2, '0')}:${now.minute.toString().padLeft(2, '0')}:${now.second.toString().padLeft(2, '0')}",
      );

      _vitalsController.add(_currentVitals);

      // Save hourly telemetry sample every minute
      if (now.second == 0) {
        Store.appendTelemetryPoint(TelemetryPoint(
          id: 'point_${now.millisecondsSinceEpoch}',
          timestamp: now.millisecondsSinceEpoch,
          timeStr: "${now.hour.toString().padLeft(2, '0')}:${now.minute.toString().padLeft(2, '0')}",
          hour: now.hour,
          minute: now.minute,
          heartRate: hr,
          hrv: hrv,
          stress: stress,
          emg: emg,
          oxygen: 99,
          temp: _currentVitals.temp,
          bp: _currentVitals.bp,
          cond: cond,
        ));
      }
    });

    _stateController.add("connected_simulated");
  }

  Future<void> scanAndConnectReal(Function(String) onStatus) async {
    try {
      onStatus("Requesting Bluetooth permissions...");
      if (await FlutterBluePlus.isSupported == false) {
        throw Exception("Bluetooth not supported on this device.");
      }

      onStatus("Scanning for NeuroSense Carotid Band...");
      isScanning = true;
      _stateController.add("scanning");

      await FlutterBluePlus.startScan(timeout: const Duration(seconds: 5));
      BluetoothDevice? foundDevice;

      final subscription = FlutterBluePlus.scanResults.listen((results) {
        for (ScanResult r in results) {
          if (r.device.platformName.toLowerCase().contains("neuro") ||
              r.advertisementData.serviceUuids.any((u) => u.toString().toLowerCase() == kSvcUuid.toLowerCase())) {
            foundDevice = r.device;
            FlutterBluePlus.stopScan();
            break;
          }
        }
      });

      await Future.delayed(const Duration(seconds: 5));
      await subscription.cancel();
      isScanning = false;

      if (foundDevice == null) {
        onStatus("No hardware found. Continuing on High-Fidelity Simulation.");
        startSimulation();
        return;
      }

      onStatus("Found ${foundDevice!.platformName}. Connecting GATT link...");
      await connectToDevice(foundDevice!);
    } catch (e) {
      onStatus("Bluetooth error: $e. Reverting to simulator.");
      startSimulation();
    }
  }

  Future<void> connectToDevice(BluetoothDevice device) async {
    _telemetryTimer?.cancel();
    connectedDevice = device;
    await device.connect(autoConnect: false);
    isConnected = true;
    isSimulated = false;
    _stateController.add("connected_real");

    final svcs = await device.discoverServices();
    for (var s in svcs) {
      if (s.uuid.toString().toLowerCase() == kSvcUuid.toLowerCase()) {
        for (var c in s.characteristics) {
          if (c.uuid.toString().toLowerCase() == kDataCharUuid.toLowerCase()) {
            dataChar = c;
            await c.setNotifyValue(true);
            c.lastValueStream.listen(_onDataReceived);
          } else if (c.uuid.toString().toLowerCase() == kCmdCharUuid.toLowerCase()) {
            cmdChar = c;
          }
        }
      }
    }
  }

  void _onDataReceived(List<int> bytes) {
    if (bytes.isEmpty) return;
    try {
      final str = utf8.decode(bytes);
      final j = jsonDecode(str);
      _currentVitals = VitalsData.fromJson(j);
      _vitalsController.add(_currentVitals);

      if (j['ppg'] != null) {
        _ppgStreamController.add((j['ppg'] as num).toDouble());
      }
    } catch (_) {}
  }

  Future<void> sendCommand(String cmd) async {
    if (cmdChar != null) {
      try {
        await cmdChar!.write(utf8.encode(cmd));
      } catch (e) {
        debugPrint("BLE write error: $e");
      }
    }
  }

  void vibrate() => sendCommand("VIB:PULSE");
  void triggerStimulation() => sendCommand("STIM:VAGUS:ACTIVATE");
  void disconnect() {
    connectedDevice?.disconnect();
    connectedDevice = null;
    isConnected = false;
    startSimulation();
  }
}

