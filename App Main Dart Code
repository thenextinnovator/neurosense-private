class _ClinicalAiDoctorTabState extends State<ClinicalAiDoctorTab> {
  final _docMsgCtrl = TextEditingController();
  List<ChatMessage> _docChats = [];
  List<LabReport> _labs = Store.getLabReports();
  List<DoctorClinic> _clinics = Store.getClinics();
  bool _docLoading = false;

  @override
  void initState() {
    super.initState();
    _docChats = Store.getDoctorChats();
    if (_docChats.isEmpty) {
      _docChats.add(ChatMessage(
        id: 'doc_init',
        role: 'ai',
        text: "Good day ${widget.profile.name}. I am Dr. Neuro, senior clinical consultant for your NeuroSense ecosystem. I review real-time carotid baroreceptor waveforms, ECG variations, and lab assays. How may I clinically assist you today?",
        timestamp: 'Just now',
      ));
    }
  }

  Future<void> _sendDoctorMessage(String text) async {
    final query = text.trim();
    if (query.isEmpty || _docLoading) return;

    final nowStr = "${DateTime.now().hour.toString().padLeft(2, '0')}:${DateTime.now().minute.toString().padLeft(2, '0')}";
    final userMsg = ChatMessage(id: 'du_${DateTime.now().millisecondsSinceEpoch}', role: 'user', text: query, timestamp: nowStr);

    setState(() {
      _docChats.add(userMsg);
      _docLoading = true;
      _docMsgCtrl.clear();
    });

    try {
      final res = await http.post(
        Uri.parse('${Store.proxyEndpoint}/api/ai/doctor'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'message': query,
          'patientName': widget.profile.name,
          'vitals': widget.vitals.toJson(),
          'condition': widget.vitals.cond,
          'labReports': _labs.map((l) => l.toJson()).toList(),
        }),
      ).timeout(const Duration(seconds: 8));

      final j = jsonDecode(res.body);
      final reply = j['reply'] ?? "Clinical telemetry remains stable. Carotid dicrotic notch is well-defined.";
      final aiMsg = ChatMessage(id: 'da_${DateTime.now().millisecondsSinceEpoch}', role: 'ai', text: reply, timestamp: nowStr);
      setState(() => _docChats.add(aiMsg));
    } catch (_) {
      const fallback = "Clinical evaluation: Heart rate and HRV variance correspond to expected resting baroreceptor thresholds. Continue current hydration and somatic vagal protocols.";
      final aiMsg = ChatMessage(id: 'da_${DateTime.now().millisecondsSinceEpoch}', role: 'ai', text: fallback, timestamp: nowStr);
      setState(() => _docChats.add(aiMsg));
    }

    Store.saveDoctorChats(_docChats);
    setState(() => _docLoading = false);
  }

