class _GuardianTabState extends State<GuardianTab> {
  int _breathSec = 4;
  String _breathPhase = 'Inhale';
  Timer? _breathTimer;
  bool _breathingActive = false;

  void _toggleBreathing() {
    setState(() => _breathingActive = !_breathingActive);
    if (_breathingActive) {
      AudioEngine.instance.speak("Starting 4-4-4-4 box breathing. Inhale slowly through your nose.");
      _breathTimer = Timer.periodic(const Duration(seconds: 1), (_) {
        setState(() {
          if (_breathSec <= 1) {
            _breathSec = 4;
            if (_breathPhase == 'Inhale') {
              _breathPhase = 'Hold';
              AudioEngine.instance.speak("Hold.");
            } else if (_breathPhase == 'Hold') {
              _breathPhase = 'Exhale';
              AudioEngine.instance.speak("Exhale smoothly.");
            } else if (_breathPhase == 'Exhale') {
              _breathPhase = 'Pause';
              AudioEngine.instance.speak("Pause.");
            } else {
              _breathPhase = 'Inhale';
              AudioEngine.instance.speak("Inhale.");
            }
            BleService.instance.vibrate();
          } else {
            _breathSec--;
          }
        });
      });
    } else {
      _breathTimer?.cancel();
    }
  }

