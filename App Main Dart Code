class _HelixOrbPainter extends CustomPainter {
  final double angle;
  final Color color;
  _HelixOrbPainter({required this.angle, required this.color});
  @override
  void paint(Canvas canvas, Size size) {
    final c = Offset(size.width / 2, size.height / 2);
    final r = size.width / 2;
    final p = Paint()
      ..color = color.withValues(alpha: 0.25)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5;

    canvas.drawArc(Rect.fromCircle(center: c, radius: r * 0.9), angle, 3.5, false, p);
    canvas.drawArc(Rect.fromCircle(center: c, radius: r * 0.7), -angle * 1.5, 2.5, false, p);
    canvas.drawArc(Rect.fromCircle(center: c, radius: r * 0.5), -angle, 4.2, false, p);
    canvas.drawCircle(c, r * 0.22, Paint()..color = Colors.white);
  }
  @override bool shouldRepaint(covariant _HelixOrbPainter old) => old.angle != angle || old.color != color;
}

